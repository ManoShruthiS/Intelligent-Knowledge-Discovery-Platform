GEMINI_API_KEY=your_gemini_key_here
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=your_groq_key_here
GROQ_API_KEYS=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

GITHUB_TOKEN=your_github_token_here

TASK_PROVIDER_RESEARCH=gemini
TASK_PROVIDER_CODING=gemini


KNO_EMBEDDING_MODEL=minilm
HF_TOKEN=
JINA_API_KEY=
COHERE_API_KEY=

KNO_RERANKER=none
KNO_BGE_RERANKER_MODEL=BAAI/bge-reranker-base
KNO_RERANK_TOP_K=25

KNO_QUERY_REWRITER=rewrite
KNO_DISABLE_QUERY_REWRITE=

KNO_LOST_IN_MIDDLE=1


KNO_HYBRID_SEARCH=bm25
KNO_HYBRID_DENSE_WEIGHT=0.6

KNO_CONTEXTUAL_RETRIEVAL=1

KNO_SELF_CRITIQUE=1

KNO_MEMORY_SUMMARIZE_THRESHOLD=12


KNO_AGENTIC=1
KNO_AGENTIC_MAX_STEPS=3

KNO_GRAPHRAG=1
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
KNO_GRAPHRAG_FALLBACK_SQLITE=1

KNO_WEB_FALLBACK=1
TAVILY_API_KEY=
SERPER_API_KEY=

YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here


KNO_MULTI_HEAD_RERANKER=1
KNO_MULTI_HEAD_WEIGHTS=cross-encoder:0.5,lexical:0.2,structural:0.1,semantic:0.2
KNO_MULTI_HEAD_CANDIDATE_K=15

KNO_HIERARCHICAL_ATTENTION=1
KNO_HIERARCHICAL_TOP_SECTIONS=6

KNO_ATTENTION_HEATMAP=1
KNO_ATTENTION_HEATMAP_MAX_TOKENS=96
